# ─────────────────────────────────────────────
# home-llm — Environment Configuration
# cp .env.example .env แล้วแก้ค่าตามต้องการ
# ⚠️  อย่า commit ไฟล์ .env ขึ้น git เด็ดขาด
# ─────────────────────────────────────────────

# ── Assistant Identity ──
ASSISTANT_NAME=Jarvis
LANGUAGE=th
DEBUG=false

# ── LLM (Ollama) ──
LLM__MODEL=llama3.2:3b         # หรือ mistral:7b ถ้า RAM ≥ 16GB
LLM__BASE_URL=http://localhost:11434
LLM__TEMPERATURE=0.7
LLM__MAX_TOKENS=512

# ── Audio ──
AUDIO__SAMPLE_RATE=16000
AUDIO__CHUNK_SIZE=1024
AUDIO__SILENCE_THRESHOLD=0.02   # 0.01 = sensitive, 0.05 = less sensitive
AUDIO__SILENCE_DURATION=1.5     # วินาทีที่เงียบก่อนหยุดฟัง
AUDIO__DEVICE_INDEX=            # ว่าง = ใช้ default mic

# ── Wake Word ──
WAKE_WORD__PHRASE=hey jarvis    # คำปลุกผู้ช่วย
WAKE_WORD__THRESHOLD=0.5        # 0.0–1.0 (สูง = เข้มงวดขึ้น)
WAKE_WORD__ENABLED=true

# ── Security / Speaker ID ──
SECURITY__SPEAKER_THRESHOLD=0.82   # ความคล้ายเสียงขั้นต่ำ (0.0–1.0)
SECURITY__MAX_FAILED_ATTEMPTS=3
SECURITY__LOCKOUT_DURATION=60      # วินาที
SECURITY__VERIFY_SPEAKER=true      # ปิดเพื่อ skip speaker check

# ── TTS ──
TTS__ENGINE=macos               # macos | kokoro
TTS__VOICE=Kanya                # macOS voices: Kanya, Narisa (ไทย)
TTS__RATE=185                   # คำต่อนาที

# ── Memory ──
MEMORY__MAX_HISTORY=20          # จำนวน turn สูงสุดใน short-term
MEMORY__PERSIST_DIR=data/memory

# ── Integrations (optional) ──
GMAIL_CREDENTIALS_PATH=         # path ไปยัง credentials.json จาก Google Cloud
SEARXNG_URL=http://localhost:8888

# ── Paths ──
DATA_DIR=data
LOGS_DIR=data/logs
